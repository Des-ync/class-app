{
  "cli": {
    "version": "25.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "demo"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "node": "24.19.0"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_PRIVACY_URL": "https://shuttlepass-demo.netlify.app/privacy/",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "kingema93@gmail.com",
        "EXPO_IOS_NON_EXEMPT_ENCRYPTION": "false"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "node": "24.19.0"
    },
    "beta": {
      "extends": "production",
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_PRIVACY_URL": "https://shuttlepass-demo.netlify.app/privacy/",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "kingema93@gmail.com",
        "EXPO_IOS_NON_EXEMPT_ENCRYPTION": "false"
      },
      "ios": {
        "simulator": false
      },
      "node": "24.19.0"
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_PRIVACY_URL": "https://shuttlepass-demo.netlify.app/privacy/",
        "EXPO_PUBLIC_SUPPORT_EMAIL": "kingema93@gmail.com",
        "EXPO_IOS_NON_EXEMPT_ENCRYPTION": "false"
      },
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "node": "24.19.0"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      },
      "ios": {
        "appName": "ShuttlePass Demo",
        "sku": "shuttlepass-demo",
        "language": "en-US"
      }
    },
    "beta": {
      "ios": {
        "appName": "ShuttlePass Demo",
        "sku": "shuttlepass-demo",
        "language": "en-US"
      }
    }
  }
}
