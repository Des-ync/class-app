# Public values are compiled into the app. Never put secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_APP_ENV=demo
# Set these through EAS environments after linking a project owned by the operator.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_APP_OWNER=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_DELETION_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
# Set true/false only after the operator classifies the actual release encryption.
EXPO_IOS_NON_EXEMPT_ENCRYPTION=
# EXPO_TOKEN belongs in CI secrets, never in a committed file or EXPO_PUBLIC_*.
# Payment, database, issuer signing and store service-account secrets belong on
# their servers/EAS credential store, never in the mobile environment.
