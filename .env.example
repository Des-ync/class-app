# Public values are compiled into the app. Never put secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_APP_ENV=demo
# Set these through EAS environments after linking a project you own.
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_APP_OWNER=
# Public HTTPS page hosting PRIVACY.md; linked from Profile > Privacy & support.
EXPO_PUBLIC_PRIVACY_URL=
# Shown in the app and required on both store listings.
EXPO_PUBLIC_SUPPORT_EMAIL=
# true/false: your export-compliance answer (see release/data-inventory.md).
EXPO_IOS_NON_EXEMPT_ENCRYPTION=
# EXPO_TOKEN belongs in CI secrets, never in a committed file or EXPO_PUBLIC_*.
