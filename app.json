{
  "expo": {
    "name": "ShuttlePass",
    "slug": "shuttlepass",
    "owner": "desyncc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.shuttlepass.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0F172A"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.shuttlepass.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing"
    ],
    "scheme": "shuttlepass",
    "extra": {
      "appEnvironment": "demo",
      "dataMode": "simulation",
      "eas": {
        "projectId": "7a5a2774-292f-4e01-9610-35bdd9ead449"
      }
    }
  }
}
